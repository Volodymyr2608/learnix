# ── Local dev (docker-compose.n8n.yml) ───────────────────────────────────────
# No extra vars needed for local — defaults in the compose file are sufficient.

# ── Production (docker-compose.n8n.prod.yml) ─────────────────────────────────

# Domain n8n is reachable at (no protocol, no trailing slash)
# Example: n8n.learnixacademy.com
N8N_DOMAIN=n8n.yourdomain.com

# Random 32-char string — protects the credentials stored in n8n's DB.
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Password for n8n's internal Postgres instance
# Generate: openssl rand -hex 24
N8N_DB_PASSWORD=

# ── Learnix env vars (also add to .env.local / Vercel dashboard) ──────────────

# Base URL of the n8n instance that Learnix POSTs events to.
# Local:  http://localhost:5678/webhook
# Prod:   https://n8n.yourdomain.com/webhook
# Main app URL — used by workflows to call back into the Learnix API
BASE_URL=https://learnixacademy.com

N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# Shared secret for HMAC-SHA256 signing of outbound webhook payloads.
# Must match N8N_WEBHOOK_SECRET set in n8n UI → Settings → Environment Variables.
# Generate: openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# Bearer token n8n sends on every inbound call to /api/notifications/*.
# Also used as the JWT signing key for certificate + unsubscribe tokens.
# Generate: openssl rand -hex 32
N8N_API_TOKEN=

# n8n REST API key (for pnpm sync:n8n — set in Settings → API in the n8n UI after first login)
N8N_API_KEY=

# n8n base URL used by sync:n8n
# Local:  http://localhost:5678
# Prod:   https://n8n.yourdomain.com
N8N_API_URL=http://localhost:5678