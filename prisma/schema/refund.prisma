enum RefundReason {
  too_easy
  too_hard
  thin_content
  other
}

enum RefundDecision {
  auto_approved
  auto_denied
}

/// R1: where an approved request's Stripe refund stands. Null for a denial.
enum RefundState {
  processing
  refunded
}

// A student's refund request (FR-S5). One per payment (FR-S7); the snapshot
// freezes every condition at submission. Shape: RefundSnapshot in
// server/entities/refund.ts.
model RefundRequest {
  id               String         @id @default(cuid())
  paymentId        String         @unique @map("payment_id")
  payment          Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  studentId        String         @map("student_id")
  student          User           @relation("StudentRefundRequests", fields: [studentId], references: [id], onDelete: Restrict)
  courseId         String         @map("course_id")
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  reason           RefundReason
  text             String?        @db.VarChar(2000)
  decision         RefundDecision
  failedConditions String[]       @map("failed_conditions")
  snapshot         Json
  /// FR-S20: `processing` until Stripe confirms; failures stay `processing` with refundError.
  refundState      RefundState?   @map("refund_state")
  stripeRefundId   String?        @unique @map("stripe_refund_id")
  /// Stripe's message, for the admin only — never shown to the student (FR-S20, C23).
  refundError      String?        @map("refund_error")
  refundedAt       DateTime?      @map("refunded_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([studentId, decision, createdAt])
  @@index([studentId, courseId, decision])
  @@map("refund_requests")
}
