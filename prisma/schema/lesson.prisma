model Lesson {
  id              String @id @default(cuid())
  title           String
  durationMinutes Int?   @map("duration_minutes")

  description String?
  videoUrl    String? @map("video_url")
  content     String? @db.Text
  resources   Json?

  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deletedAt DateTime? @map("deleted_at")

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  quizzes                      Quiz[]
  progresses                   LessonProgress[]
  lessonInsights               LessonInsights?
  chunkEmbeddings              LessonChunkEmbedding[]
  lessonAssistantConversations LessonAssistantConversation[]
  conceptChecks                ConceptCheck[]
  openedBy                     OpenedLesson[]

  @@index([deletedAt])
  @@map("lessons")
}

model LessonProgress {
  id String @id @default(cuid())

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  isCompleted Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model LessonInsights {
  id          String   @id @default(cuid())
  lessonId    String   @unique
  summary     String   @db.Text
  concepts    Json
  glossary    Json
  model       String
  contentHash String
  generatedAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_insights")
}

// A lesson whose content was returned to the student (FR-P19). Written before
// the content is returned; one row per (student, lesson) — opening twice counts once.
model OpenedLesson {
  studentId String   @map("student_id")
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String   @map("lesson_id")
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  openedAt  DateTime @default(now()) @map("opened_at")

  @@id([studentId, lessonId])
  @@map("opened_lessons")
}
