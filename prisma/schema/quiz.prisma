model Quiz {
  id       String   @id @default(cuid())
  question String
  options  String[]
  correct  String

  deletedAt DateTime? @map("deleted_at")

  lessonId String
  lesson   Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@index([deletedAt])
  @@map("quizzes")
}

model QuizAttempt {
  id String @id @default(cuid())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  selectedAnswer String
  isCorrect      Boolean

  /// How many graded attempts this row represents. NULL means "unknown": the row
  /// predates the counter, back when a retry overwrote its own attempt in place.
  /// Never backfilled — count(*) is 1 for a quiz retried twenty times.
  attemptCount Int?

  createdAt DateTime @default(now())
  /// The cooldown clock. `createdAt` stays pinned to the first attempt because
  /// the row is updated in place, so the cap needs a timestamp that moves.
  updatedAt DateTime @updatedAt

  @@unique([quizId, studentId])
  @@index([quizId])
  @@index([studentId])
  @@map("quiz_attempts")
}
