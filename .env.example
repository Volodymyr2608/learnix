# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Better Auth GitHub OAuth
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""

# Better Auth Google OAuth
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

# Public app URL (used to build absolute links in emails, PDFs, etc.)
BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL=""

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="Learnix App"

OPENAI_API_KEY=""

# Resend (transactional email)
RESEND_API_KEY="re_test_..."
EMAIL_FROM_ADDRESS="hello@learnix.app"
EMAIL_REPLY_TO="support@learnix.app"

# n8n webhook secret (also used to auth POST /api/emails/send)
N8N_API_TOKEN=""
# n8n instance base URL and HMAC secret for outbound n8n calls (inactivity-nudge job only)
N8N_WEBHOOK_BASE_URL="http://localhost:5678"
N8N_WEBHOOK_SECRET=""
# Secret for signing certificate download JWTs (separate from N8N_API_TOKEN)
CERTIFICATE_SECRET=""
# Secret for signing billing invoice download JWTs (separate from CERTIFICATE_SECRET)
INVOICE_SECRET=""
# Secret for signing email unsubscribe JWTs (separate from N8N_API_TOKEN)
UNSUBSCRIBE_SECRET=""

# Stripe (server-side only — no publishable key needed)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Separate webhook signing secret for Connect events (account.updated)
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."
STRIPE_PLATFORM_FEE_PERCENT=20

# AI rate limiter store (Vercel Upstash/KV integration).
# Required in production — startup fails without them, deliberately: falling back
# to the in-memory limiter makes the ceiling per-instance (risk R3).
# Optional locally; without them the limiter uses its in-memory adapter.
# Local testing uses serverless-redis-http from docker-compose (see README).
# Do NOT use KV_REST_API_READ_ONLY_TOKEN: the limiter only ever writes.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
